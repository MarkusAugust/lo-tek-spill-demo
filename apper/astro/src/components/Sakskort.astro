---
import { lt } from "@lo-tek/interfaces"

import type { SakUt } from "../lib/tilstand"

interface Props {
  sak: SakUt
}

const { sak } = Astro.props

/*
 * Saken slik den ligger på bordet.
 *
 * Fella ligger i opplysningene om søkeren, ikke i teksten, så begge fanene
 * må leses. Det er hele oppgaven.
 *
 * Fanene her har ingen tilstand på serveren: `<lt-tabs>` tar over i
 * nettleseren og flytter valget med piltastene. Serveren skriver lenkene og
 * id-ene på panelene, komponenten skriver rollene og resten.
 */
const { class: kortKlasse, ...kort } = lt.card()
const { class: tittelKlasse, ...tittel } = lt.heading({ size: "m" })
const { class: ingressKlasse, ...ingress } = lt.paragraph()
const { class: tekstKlasse, ...tekst } = lt.paragraph()
const deler = [
  { nokkel: "soknaden", navn: "Søknaden" },
  { nokkel: "soker", navn: "Søkeren" },
]
const faner = lt.tabs({ id: "sak", keys: deler.map((d) => d.nokkel), label: "Saken" })
---

<section {...kort} class={`${kortKlasse} kort sakskort`}>
  <p class="sakskort__stempel">
    <span {...lt.tag()}>Sak {sak.id}</span>
    <span class="sakskort__status">Til behandling</span>
  </p>

  <h2 {...tittel} class={`${tittelKlasse} sakskort__tittel`}>{sak.tittel}</h2>
  <p {...ingress} class={`${ingressKlasse} sakskort__ingress`}>{sak.sammendrag}</p>

  <lt-tabs class="sakskort__faner">
    <ul {...faner.list}>
      {deler.map((del, i) => <li><a {...faner.tabs[i]}>{del.navn}</a></li>)}
    </ul>

    <div {...faner.panels[0]}>
      <p {...tekst} class={`${tekstKlasse} sakskort__tekst`}>{sak.tekst}</p>
      <p class="sakskort__signatur">
        Med vennlig hilsen<br />{sak.soker.navn}
      </p>
    </div>

    <div {...faner.panels[1]}>
      <table {...lt.table()} aria-label="Opplysninger om søkeren">
        <tbody>
          <tr><th scope="row">Navn</th><td>{sak.soker.navn}</td></tr>
          <tr><th scope="row">Fødselsdato</th><td>{sak.soker.fodselsdato}</td></tr>
          <tr><th scope="row">Kommune</th><td>{sak.soker.kommune}</td></tr>
          <tr><th scope="row">E-post</th><td>{sak.soker.epost}</td></tr>
        </tbody>
      </table>
    </div>
  </lt-tabs>
</section>
