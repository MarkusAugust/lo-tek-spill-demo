---
import { lt } from "@lo-tek/interfaces"

import type { Feil, Tilstand } from "../lib/tilstand"

interface Props {
  tilstand: Tilstand
  kommuner: string[]
  feil: Feil[]
  svar: { vedtak: string; hjemmel: string; kommune: string; felle: string }
}

const { tilstand, kommuner, feil, svar } = Astro.props
const feilPa = (felt: string) => feil.find((f) => f.felt === felt)

/*
 * Skjemaet saksbehandleren fyller ut.
 *
 * Her er det en helt vanlig `<form method="post">`. Svaret er en ny side med
 * kvittering, eller den samme siden med feiloppsummeringen øverst. Ingen av
 * delene trenger JavaScript, og det er nettopp poenget med denne utgaven.
 *
 * Kommunefeltet er det eneste som blir bedre av skript: `<lt-suggestion>`
 * filtrerer lista og tar piltastene. Serveren sender hele lista, og uten
 * komponenten er feltet fortsatt et tekstfelt med en liste under.
 */
const { class: kortKlasse, ...kort } = lt.card()
const tittel = lt.heading({ size: "s" })
const boks = lt.errorSummary({ count: feil.length, id: "feilboks" })
// `hidden` skrives bokstavelig: Astro sprer `true` som `hidden="true"` på et
// egendefinert element, og det er feil form for et boolsk attributt.
const { hidden: skjult, ...feilboks } = boks.host
const { class: knappKlasse, ...knapp } = lt.button()
const utfall = lt.fieldset({ state: feilPa("v-innvilget") ? "invalid" : undefined })
const forslag = lt.suggestion({
  id: "kommune",
  keys: kommuner,
  help: true,
  error: Boolean(feilPa("kommune")),
  invalid: Boolean(feilPa("kommune")),
})
/* Sprettoppvinduet med hjemlene. Ett kall, tre attributtsett: verten,
   knappen og panelet hører sammen og deler id. */
const hjelp = lt.popover({ id: "hjemmelhjelp" })
// Klassen trekkes ut: `{...lt.list()} class="…"` gir to class-attributter, og
// nettleseren beholder det første.
const { class: listeKlasse, ...liste } = lt.list()
const feller = [
  ["nei", "Nei, saken er i orden"],
  ["fodselsdato", "Fødselsdatoen"],
  ["kommune", "Kommunen"],
  ["epost", "E-postadressen"],
]
---

<section {...kort} class={`${kortKlasse} kort vedtakskort`}>
  <h2 {...tittel}>Ditt vedtak</h2>
  <p class="vedtakskort__ingress">
    Fire spørsmål, {tilstand.poeng.fullPott} poeng. Du kan svare én gang.
  </p>

  <lt-error-summary {...feilboks} hidden={skjult ? "" : undefined}>
    {
      feil.length > 0 && (
        <>
          <h3 {...boks.title}>Du må rette {feil.length} feil</h3>
          <ul {...lt.list()}>
            {/* En avvisning uten felt har ikke noe å lenke til. */}
            {feil.map((f) => (
              <li>{f.felt ? <a href={`#${f.felt}`}>{f.melding}</a> : f.melding}</li>
            ))}
          </ul>
        </>
      )
    }
  </lt-error-summary>

  <form class="skjema" method="post" action="/">
    <!-- Saken skjemaet ble tegnet for. Sendes det inn etter at saken byttet,
         avviser spilltjeneren svaret i stedet for å legge det på den nye. -->
    <input type="hidden" name="sakId" value={tilstand.sak.id} />
    <fieldset {...utfall}>
      <legend {...lt.legend()}>Utfall</legend>
      {
        [
          ["innvilget", "Innvilget", "v-innvilget"],
          ["avslatt", "Avslått", "v-avslatt"],
        ].map(([verdi, tekst, id]) => (
          <div class={lt.radio.row}>
            <input
              {...lt.radio({ state: feilPa("v-innvilget") ? "invalid" : undefined })}
              type="radio"
              id={id}
              name="vedtak"
              value={verdi}
              checked={svar.vedtak === verdi}
            />
            <label {...lt.label()} for={id}>{tekst}</label>
          </div>
        ))
      }
    </fieldset>

    <lt-field>
      <label {...lt.label()} for="hjemmel">Hjemmel</label>
      <select
        {...lt.select({
          picker: "styled",
          state: feilPa("hjemmel") ? "invalid" : undefined,
        })}
        id="hjemmel"
        name="hjemmel"
        aria-describedby={feilPa("hjemmel") ? "hjemmel-feil" : undefined}
      >
        <option value="" selected={svar.hjemmel === ""}>Velg hjemmel</option>
        {
          tilstand.hjemler.map((h) => (
            <option value={h.kode} selected={svar.hjemmel === h.kode}>
              {h.kode} {h.tekst}
            </option>
          ))
        }
      </select>
      {feilPa("hjemmel") && <p {...lt.errorText()} id="hjemmel-feil">{feilPa("hjemmel")!.melding}</p>}
    </lt-field>

    <lt-popover {...hjelp.host} class="hjelpelenke" placement="bottom-start">
      <button {...hjelp.trigger} {...lt.button({ variant: "ghost" })} type="button">
        Hva betyr hjemlene?
      </button>
      <div {...hjelp.panel}>
        <ul {...liste} class={`${listeKlasse} hjemmelhjelp__liste`} tabindex="0">
          {tilstand.hjemler.map((h) => (
            <li>
              <strong>{h.kode} {h.tekst}</strong>{" "}
              <span class="hjemmelhjelp__om">{h.forklaring}</span>
            </li>
          ))}
        </ul>
      </div>
    </lt-popover>

    <!-- Antallet leses opp på norsk: standardtekstene i LO-TEK er engelske. -->
    <lt-suggestion class="kommunefelt" count-none="Ingen treff" count-one="Ett treff" count-other="{n} treff">
      <label {...forslag.label}>Bekreft kommunen søkeren hører til</label>
      <input {...forslag.control} name="kommune" value={svar.kommune} />
      <ul {...forslag.list}>
        {kommuner.map((navn, i) => <li {...forslag.options[i]}>{navn}</li>)}
      </ul>
      <p {...forslag.empty}>Ingen treff. Finnes kommunen fortsatt?</p>
      <span {...forslag.status}></span>
      <p {...lt.helpText()} {...forslag.help}>
        Begynn å skrive, så kommer forslagene. Finner du den ikke, la feltet stå tomt.
      </p>
      {feilPa("kommune") && <p {...lt.errorText()} {...forslag.error}>{feilPa("kommune")!.melding}</p>}
    </lt-suggestion>

    <lt-field>
      <label {...lt.label()} for="felle">Er noe feil i søknaden?</label>
      <select
        {...lt.select({ picker: "styled", state: feilPa("felle") ? "invalid" : undefined })}
        id="felle"
        name="felle"
        aria-describedby={`felle-hjelp${feilPa("felle") ? " felle-feil" : ""}`}
      >
        <option value="" selected={svar.felle === ""}>Velg</option>
        {
          feller.map(([verdi, tekst]) => (
            <option value={verdi} selected={svar.felle === verdi}>{tekst}</option>
          ))
        }
      </select>
      <p {...lt.helpText()} id="felle-hjelp">Å se at alt er i orden teller like mye.</p>
      {feilPa("felle") && <p {...lt.errorText()} id="felle-feil">{feilPa("felle")!.melding}</p>}
    </lt-field>

    <button {...knapp} class={`${knappKlasse} skjema__send`} type="submit">
      Fatt vedtak
    </button>
  </form>
</section>
